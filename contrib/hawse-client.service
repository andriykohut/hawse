[Unit]
Description=hawse tunnel client
Documentation=https://andriykohut.github.io/hawse/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/hawse client --config /etc/hawse/client.toml --log pretty
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s

# The service has no home, so the config path cannot be discovered and is given
# above.
ConfigurationDirectory=hawse
StateDirectory=hawse
RuntimeDirectory=hawse-client
DynamicUser=yes
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
# AF_UNIX is for the name resolver, which may talk to nscd or systemd-resolved, and for the
# socket that hawse status asks.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
