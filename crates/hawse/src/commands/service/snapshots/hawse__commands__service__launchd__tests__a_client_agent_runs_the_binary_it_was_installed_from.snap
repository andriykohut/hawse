<!-- Written by hawse service install. Run it again to update this file. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.andriykohut.hawse.client</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/hawse/hawse</string>
		<string>client</string>
		<string>--config</string>
		<string>/Users/someone/.config/hawse/client.toml</string>
		<string>--log</string>
		<string>oslog</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/Users/someone/Library/Logs/hawse/client.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/someone/Library/Logs/hawse/client.log</string>
</dict>
</plist>
